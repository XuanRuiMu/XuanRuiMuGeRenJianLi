# 「会解压的外星人」聊天功能的服务端配置模板。
# 复制为 .env 后填入真实值：cp .env.example .env
# 注意：这些变量只在服务端使用，不要加 PUBLIC_ 前缀，否则会被打进浏览器包体。

# OpenAI 兼容接口（DeepSeek / 智谱 / 通义千问 等任选其一）
CHAT_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_OPENAI_API_KEY=你的_API_KEY
CHAT_OPENAI_MODEL=qwen-turbo

# 令牌签名密钥，请替换为随机长字符串（至少 32 字符）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_JWT_SECRET=请填入至少32位的随机字符串
CHAT_CSRF_SECRET=请填入至少32位的随机字符串

# 聊天记录数据库（SQLite，首次运行自动创建）
CHAT_DB_PATH=./data/chat.sqlite

# ---- 可选：调优参数，不填则用代码里的默认值 ----
# CHAT_MAX_MESSAGE_LENGTH=2000
# CHAT_CONTEXT_TURNS=20
# CHAT_RATE_LIMIT=15
# CHAT_RATE_WINDOW_MS=60000
# CHAT_UPSTREAM_TIMEOUT_MS=60000
# CHAT_TOKEN_TTL_SECONDS=604800
