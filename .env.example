# 前端功能开关
VITE_ENABLE_ANALYTICS=false

# AI 反代密钥（仅供 vite.config.js / nginx 反代注入，禁止加 VITE_ 前缀进入前端产物）
# 本地放 .env.local（已 gitignore）。生产见 deploy/nginx.conf 的 snippets/ai-keys.conf
DEEPSEEK_API_KEY=

# GLM 预留通道（Anthropic 兼容；模型列表接入后 endpoint 指到 /api/ai/glm）
# GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# GLM_API_KEY=
# GLM_MODEL=glm-4.7-flash