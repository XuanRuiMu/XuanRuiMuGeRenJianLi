{
  "ignorePatterns": [
    "dist",
    "dev-dist",
    "playwright-report",
    "test-results",
    "coverage",
    "node_modules",
    "临时素材",
    ".workbuddy",
    "图片_旧",
    "data",
    "public/fonts"
  ],
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  }
}
