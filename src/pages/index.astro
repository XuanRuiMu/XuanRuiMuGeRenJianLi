---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import IntroCard from "../components/IntroCard.astro";
import ContactsCard from "../components/ContactsCard.astro";
import ThemeChangeCard from "../components/ThemeChangeCard.astro";
import TimeZone from "../components/TimeZoneCard.astro";
import AboutMe from "../components/AboutMe.astro";
import Now from "../components/Now.astro";
import PixelHeart from "../components/PixelHeart.astro";
import { SITE } from "../site-config";

export const prerender = true;
---

<script>
  import { initHomeEntrance } from "../lib/home-entrance";
  initHomeEntrance();
</script>

<Layout
  description={`我是${SITE.author.fullName}，一名刚毕业的应届生，唯一的核心能力是用 AI Agent 解决问题、完成工作。正在寻找计算机相关的工作。`}
  title={`${SITE.author.fullName} - ${SITE.author.jobTitle}`}
>
  <main
    class="text-white m-auto p-2 grid gap-2 max-w-6xl overflow-x-hidden relative w-full sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 xl:h-[max(100dvh,830px)] xl:grid-rows-8 xl:grid-cols-4 xl:gap-4"
  >
    <IntroCard />
    <AboutMe />
    <ContactsCard />
    <TimeZone />
    <Now />
    <Card colSpan="md:col-span-1" href={SITE.links.game} rowSpan="md:row-span-1">
      <div class="flex-1 flex items-center">
        <h2 class="text-xl md:text-2xl xl:text-xl font-bold m-0">我的游戏世界</h2>
      </div>
    </Card>
    <Card
      colSpan="md:col-span-1"
      href={SITE.links.chat}
      rowSpan="md:row-span-1"
    >
      <div class="flex flex-col justify-center gap-2 h-full">
        <h2 class="text-xl md:text-2xl xl:text-xl font-bold m-0">会解压的外星人</h2>
        <p class="text-3xs text-darkslate-300 m-0">
          AI 陪伴聊天 · SSE 流式 · 登录可跨设备留存
        </p>
      </div>
    </Card>
    <Card colSpan="md:col-span-1" href="/projects" rowSpan="md:row-span-1">
      <div class="flex flex-col justify-center gap-2 h-full">
        <h2 class="text-xl md:text-2xl xl:text-xl font-bold m-0">技术栈工坊</h2>
        <p class="text-3xs text-darkslate-300 m-0">
          每个项目都能在前端真跑 · 聊天全栈 / JD 匹配 / 游戏引擎 / 质量自检
        </p>
      </div>
    </Card>
    <Card
      colSpan="md:col-span-1"
      href={SITE.links.audit}
      rowSpan="md:row-span-1"
    >
      <div class="flex flex-col justify-center gap-2 h-full">
        <h2 class="text-xl md:text-2xl xl:text-xl font-bold m-0">站点质量自检台</h2>
        <p class="text-3xs text-darkslate-300 m-0">
          对比度 / 链接 / 键盘可达性 · 浏览器内真实跑
        </p>
      </div>
    </Card>
    <ThemeChangeCard />
    <Card colSpan="md:col-span-1" rowSpan="md:row-span-1">
      <div class="flex h-full items-center justify-center">
        <p class="text-3xs text-center whitespace-nowrap">
          © {new Date().getFullYear()} · 由 <PixelHeart /> 与 <a
            class="text-red-500"
            href="https://astro.build/"
            target="_blank">Astro</a
          > 驱动，{SITE.author.shortName} 制作。
        </p>
      </div>
    </Card>
  </main>
</Layout>
