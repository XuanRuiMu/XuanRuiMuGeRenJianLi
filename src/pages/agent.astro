---
import BasicLayout from "../layouts/BasicLayout.astro";
import { SITE } from "../site-config";
import "../styles/agent.css";

const 快捷问题 = [
  "有哪些项目？",
  "会什么技术？",
  "你真的会写代码吗？",
  "最大的差异化优势是什么？",
  "我适合什么岗位？",
];
---

<BasicLayout
  description="简历 × JD 匹配分析器 - 纯前端离线分析，技能关键词匹配 / 匹配度评分 / 差距分析"
  title={`简历 × JD 匹配分析器 - ${SITE.author.fullName}`}
>
  <main class="agent-main">
    <div class="agent-shell">
      <header class="agent-head">
        <div>
          <h1>简历 × JD 匹配分析器</h1>
          <p class="agent-sub">
            本地离线分析 · 无需后端 · 纯前端实现（技能关键词抽取 / 匹配度评分 / 差距分析）
          </p>
        </div>
        <a class="back-home" href="/">← 返回简历</a>
      </header>

      <div class="agent-grid">
        <section class="chat-panel" aria-label="对话区">
          <div class="chat-scroll" id="chatScroll">
            <div class="bubble assistant">
              <div class="content">
                你好，我是内嵌于本简历站的「简历 × JD 匹配分析器」。你可以：
                ① 在右侧粘贴职位描述（JD）并点「分析匹配度」，我会输出综合评分、已匹配技能、差距技能与针对性建议；
                ② 点击快捷提问了解我的项目、技术与适合岗位。所有计算在浏览器内完成，无需联网。
              </div>
            </div>
          </div>
          <form class="input-row" id="chatForm">
            <input
              id="chatInput"
              type="text"
              placeholder="输入问题，或直接粘贴 JD 全文…"
              autocomplete="off"
            />
            <button id="sendBtn" type="submit">发送</button>
          </form>
        </section>

        <aside class="side-panel" aria-label="快捷操作">
          <div class="side-block">
            <h2>快捷提问</h2>
            <div class="quick-list">
              {
                快捷问题.map((问题) => (
                  <button class="quick-btn" data-question={问题} type="button">
                    {问题}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="side-block">
            <h2>JD 岗位匹配分析</h2>
            <textarea
              id="jdInput"
              rows="6"
              placeholder="粘贴职位描述全文（岗位职责 / 任职要求）…"
            ></textarea>
            <button id="jdBtn" class="primary" type="button">
              分析匹配度
            </button>
          </div>
          <div class="side-block meta-block">
            <p>运行方式：浏览器本地计算 · 无网络请求 · 无密钥</p>
            <p>算法：技能词典（含中英文别名）关键词抽取 → 画像比对 → 评分</p>
            <p>技术名词保留原文：React / TypeScript / FastAPI / MySQL / RAG / MCP 等</p>
          </div>
        </aside>
      </div>
    </div>
  </main>
</BasicLayout>

<script>
  import { 创建控制台 } from "../lib/agent-console";

  const 初始化 = (): void => {
    const 容器 = document.getElementById("chatScroll");
    if (!容器 || 容器.dataset.consoleReady === "1") return;
    容器.dataset.consoleReady = "1";
    创建控制台({
      对话容器: 容器,
      表单: document.getElementById("chatForm") as HTMLFormElement,
      输入框: document.getElementById("chatInput") as HTMLInputElement,
      发送按钮: document.getElementById("sendBtn") as HTMLButtonElement,
      JD输入: document.getElementById("jdInput") as HTMLTextAreaElement,
      JD按钮: document.getElementById("jdBtn") as HTMLButtonElement,
    });
  };

  初始化();
  document.addEventListener("astro:page-load", 初始化);
</script>
