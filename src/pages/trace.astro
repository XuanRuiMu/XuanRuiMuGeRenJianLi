---
import BasicLayout from "../layouts/BasicLayout.astro";
import { SITE } from "../site-config";
import "../styles/projects.css";
import "../styles/trace.css";
import { 观测台文案 } from "../lib/locales/trace";
---

<BasicLayout
  description="AI Agent 运行时观测台 - 把 ReAct 循环的思考、工具调用、观察与轨迹耗时摊开呈现"
  title={`${观测台文案.标题} - ${SITE.author.fullName}`}
>
  <main class="pj-main">
    <div class="pj-shell">
      <header class="pj-head">
        <div>
          <h1>{观测台文案.标题}</h1>
          <p class="pj-sub">{观测台文案.副标题}</p>
        </div>
        <a class="back-home" href="/">← 返回简历</a>
      </header>

      <section class="tr-ask" aria-label="提问区">
        <textarea
          id="trInput"
          rows="2"
          placeholder={观测台文案.输入提示}
          aria-label={观测台文案.输入提示}></textarea>
        <div class="tr-ask-actions">
          <button id="trRun" class="tr-btn primary" type="button">
            {观测台文案.提问}
          </button>
          <button id="trStop" class="tr-btn" type="button" hidden>
            {观测台文案.停止}
          </button>
          <span id="trStatus" class="tr-status" role="status"
            >{观测台文案.状态.连接中}</span
          >
        </div>
        <div class="tr-samples">
          {
            观测台文案.示例问题.map((问题) => (
              <button class="tr-sample" type="button" data-question={问题}>
                {问题}
              </button>
            ))
          }
        </div>
      </section>

      <p class="tr-offline" id="trOffline" role="alert" hidden>
        {观测台文案.状态.后端离线}
      </p>

      <section class="tr-run" id="trRunPanel" aria-label="运行时" hidden>
        <div class="tr-run-head">
          <h2>运行时事件流</h2>
          <span class="tr-run-meta" id="trMeta"></span>
        </div>
        <div class="tr-events" id="trEvents" role="log" aria-live="polite"></div>
      </section>

      <section class="tr-trace" aria-label="轨迹回放">
        <div class="tr-run-head">
          <h2>轨迹回放（后端落库）</h2>
          <span class="tr-run-meta">{观测台文案.标签.轨迹说明}</span>
        </div>
        <div class="tr-timeline" id="trTimeline">
          <p class="tr-empty">{观测台文案.状态.无轨迹}</p>
        </div>
      </section>

      <section class="pj-block" aria-label="实现说明">
        <div class="pj-block-head">
          <span class="pj-index">i</span>
          <div>
            <h2>这套运行时到底做了什么</h2>
            <p class="pj-oneliner">不是演示动画，每一次运行都会真实读写数据库。</p>
          </div>
        </div>
        <ul class="au-notes">
          {观测台文案.说明.map((条目) => <li>{条目}</li>)}
        </ul>
      </section>
    </div>
  </main>
</BasicLayout>

<script>
  import { 创建观测台 } from "../lib/trace-client";

  const 初始化 = (): void => {
    if (document.getElementById("trInput") === null) return;
    const 面板 = document.getElementById("trRunPanel") as HTMLElement;
    if (面板.dataset.traceReady === "1") return;
    面板.dataset.traceReady = "1";

    创建观测台({
      输入框: document.getElementById("trInput") as HTMLTextAreaElement,
      运行按钮: document.getElementById("trRun") as HTMLButtonElement,
      停止按钮: document.getElementById("trStop") as HTMLButtonElement,
      状态: document.getElementById("trStatus") as HTMLElement,
      离线提示: document.getElementById("trOffline") as HTMLElement,
      事件容器: document.getElementById("trEvents") as HTMLElement,
      时间线: document.getElementById("trTimeline") as HTMLElement,
      元信息: document.getElementById("trMeta") as HTMLElement,
      运行面板: 面板,
      示例按钮: Array.from(document.querySelectorAll<HTMLButtonElement>(".tr-sample")),
    });
  };

  初始化();
  document.addEventListener("astro:page-load", 初始化);
</script>
