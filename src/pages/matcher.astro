---
import BasicLayout from "../layouts/BasicLayout.astro";
import { SITE } from "../site-config";
import "../styles/agent.css";
import "../styles/matcher.css";
---

<BasicLayout
  description="AI 简历匹配平台 - Spring Boot + MySQL + Redis + LLM 的全栈 AI 应用，粘贴 JD 即可分析岗位匹配度"
  title={`AI 简历匹配平台 - ${SITE.author.fullName}`}
>
  <main class="agent-main">
    <div class="agent-shell">
      <header class="agent-head">
        <div>
          <h1>AI 简历匹配平台</h1>
          <p class="agent-sub">
            Spring Boot 3 + MySQL + Redis + LLM 全栈实现 · 优雅降级 · 缓存加速 · 接口限流
          </p>
        </div>
        <a class="back-home" href="/">← 返回简历</a>
      </header>

      <div class="matcher-grid">
        <section class="matcher-panel" aria-label="JD 分析区">
          <h2>岗位 JD 匹配分析</h2>
          <textarea
            id="matcherJdInput"
            rows="10"
            placeholder="粘贴职位描述全文（岗位职责 / 任职要求）…"
          ></textarea>
          <div class="matcher-actions">
            <button id="matcherAnalyzeBtn" class="matcher-btn primary" type="button">
              分析匹配度
            </button>
            <span class="matcher-status" id="matcherStatus"></span>
          </div>

          <div class="matcher-result" id="matcherResult" hidden>
            <div class="matcher-score-row">
              <div class="matcher-score-ring" id="matcherScoreRing">
                <span id="matcherScoreNum">0</span>
              </div>
              <div class="matcher-score-meta">
                <div class="matcher-tags">
                  <span class="tag" id="matcherEngineTag">引擎</span>
                  <span class="tag" id="matcherCacheTag">缓存</span>
                </div>
                <p class="matcher-summary" id="matcherSummary"></p>
              </div>
            </div>
            <div class="matcher-cols">
              <div class="matcher-col">
                <h3>已命中技能</h3>
                <div class="skill-list matched" id="matcherMatched"></div>
              </div>
              <div class="matcher-col">
                <h3>差距技能</h3>
                <div class="skill-list missing" id="matcherMissing"></div>
              </div>
            </div>
          </div>
        </section>

        <aside class="matcher-side" aria-label="平台信息">
          <div class="side-block">
            <h2>架构与技术</h2>
            <ul class="arch-list">
              <li><b>Spring Boot 3.5</b>：REST API + Bean Validation</li>
              <li><b>MySQL 8</b>：匹配记录持久化（本地默认 H2 可直接体验）</li>
              <li><b>Redis</b>：JD 哈希缓存 + 每 IP 固定窗口限流（无 Redis 时降级 Caffeine）</li>
              <li><b>LLM 集成</b>：DeepSeek 结构化分析，失败自动降级规则引擎</li>
              <li><b>测试</b>：JUnit 5 + MockMvc 覆盖校验 / 限流 / 降级路径</li>
              <li><b>部署</b>：Dockerfile 多阶段构建 + docker-compose 一键编排</li>
            </ul>
          </div>
          <div class="side-block">
            <h2>最近分析记录</h2>
            <div class="history-list" id="matcherHistory">
              <p class="history-empty">启动后端后自动加载</p>
            </div>
          </div>
          <div class="side-block meta-block">
            <p>
              后端状态：<span id="matcherHealth" class="health-badge">检测中…</span>
            </p>
            <p>与 <a href="/agent">纯前端版匹配器</a> 互为印证：一个零依赖跑在浏览器，一个跑完整生产栈。</p>
          </div>
        </aside>
      </div>
    </div>
  </main>
</BasicLayout>

<script>
  const API_BASE = "http://localhost:8080";

  const 转义 = (文本: string): string =>
    文本.replace(/[&<>"']/g, (字符) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[字符] ?? 字符,
    );

  function 渲染结果(数据: {
    totalScore: number;
    matchedSkills: string[];
    missingSkills: string[];
    summary: string;
    engine: string;
    cacheHit: boolean;
  }): void {
    const 结果区 = document.getElementById("matcherResult");
    const 分数 = document.getElementById("matcherScoreNum");
    const 环 = document.getElementById("matcherScoreRing");
    const 引擎标签 = document.getElementById("matcherEngineTag");
    const 缓存标签 = document.getElementById("matcherCacheTag");
    const 结论 = document.getElementById("matcherSummary");
    const 命中区 = document.getElementById("matcherMatched");
    const 缺失区 = document.getElementById("matcherMissing");
    if (!结果区 || !分数 || !环 || !引擎标签 || !缓存标签 || !结论 || !命中区 || !缺失区) return;

    结果区.hidden = false;
    分数.textContent = String(数据.totalScore);
    const 比例 = 数据.totalScore / 100;
    const 角度 = Math.round(比例 * 360);
    环.style.background = `conic-gradient(var(--neon-cyan, #00f0ff) ${角度}deg, rgba(255,255,255,0.08) ${角度}deg)`;
    引擎标签.textContent = 数据.engine === "llm" ? "LLM 分析" : "规则引擎降级";
    缓存标签.textContent = 数据.cacheHit ? "命中缓存" : "实时计算";
    结论.textContent = 数据.summary;
    命中区.innerHTML = 数据.matchedSkills.length
      ? 数据.matchedSkills.map((技能) => `<span class="skill-tag">${转义(技能)}</span>`).join("")
      : '<span class="skill-tag none">无</span>';
    缺失区.innerHTML = 数据.missingSkills.length
      ? 数据.missingSkills.map((技能) => `<span class="skill-tag">${转义(技能)}</span>`).join("")
      : '<span class="skill-tag none">无——完全覆盖</span>';
  }

  async function 加载历史(): Promise<void> {
    const 列表 = document.getElementById("matcherHistory");
    if (!列表) return;
    try {
      const 响应 = await fetch(`${API_BASE}/api/match/history`);
      if (!响应.ok) throw new Error();
      const 数据 = (await 响应.json()) as Array<{
        id: number;
        totalScore: number;
        engine: string;
        createdAt: string;
      }>;
      列表.innerHTML = 数据.length
        ? 数据.slice(0, 8).map((条目) => {
            const 时间 = new Date(条目.createdAt).toLocaleString("zh-CN", { hour12: false });
            return `<div class="history-item"><span>#${条目.id}</span><b>${条目.totalScore}分</b><span>${条目.engine === "llm" ? "LLM" : "规则"}</span><time>${转义(时间)}</time></div>`;
          }).join("")
        : '<p class="history-empty">暂无记录，提交一次分析试试</p>';
    } catch {
      列表.innerHTML = '<p class="history-empty">后端未启动</p>';
    }
  }

  async function 检测健康(): Promise<void> {
    const 徽章 = document.getElementById("matcherHealth");
    if (!徽章) return;
    try {
      const 响应 = await fetch(`${API_BASE}/api/health`);
      徽章.textContent = 响应.ok ? "在线" : "异常";
      徽章.classList.toggle("online", 响应.ok);
    } catch {
      徽章.textContent = "离线（cd server-java && mvn spring-boot:run）";
    }
  }

  function 绑定(): void {
    const 按钮 = document.getElementById("matcherAnalyzeBtn") as HTMLButtonElement | null;
    const 输入 = document.getElementById("matcherJdInput") as HTMLTextAreaElement | null;
    const 状态 = document.getElementById("matcherStatus");
    if (!按钮 || !输入 || 按钮.dataset.bound === "1") return;
    按钮.dataset.bound = "1";

    按钮.addEventListener("click", async () => {
      const 文本 = 输入.value.trim();
      if (!文本) {
        if (状态) 状态.textContent = "请先粘贴 JD 内容";
        return;
      }
      按钮.disabled = true;
      if (状态) 状态.textContent = "分析中…";
      try {
        const 响应 = await fetch(`${API_BASE}/api/match`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ jdText: 文本 }),
        });
        if (!响应.ok) {
          const 错误 = (await 响应.json().catch(() => null)) as { error?: string } | null;
          throw new Error(错误?.error ?? `请求失败（${响应.status}）`);
        }
        const 数据 = await 响应.json();
        渲染结果(数据);
        if (状态) 状态.textContent = "";
        await 加载历史();
      } catch (错误) {
        if (状态) 状态.textContent = 错误 instanceof Error ? 错误.message : "网络错误，请确认后端已启动";
      } finally {
        按钮.disabled = false;
      }
    });
  }

  function 初始化(): void {
    绑定();
    检测健康();
    加载历史();
  }

  初始化();
  document.addEventListener("astro:page-load", 初始化);
</script>
