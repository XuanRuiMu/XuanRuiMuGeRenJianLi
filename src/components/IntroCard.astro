---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { Icon } from "astro-icon/components";
import Tooltip from "./Tooltip/index";
import { SITE } from "../site-config";
---

<Card colSpan="md:col-span-3" rowSpan="md:row-span-4" class="pad-lg">
  <div class="flex w-full h-full items-center">
    <div class="flex flex-col justify-between gap-4">
      <div class="flex flex-col h-full">
        {/* 首页原本没有任何 h1，对 SEO 与读屏导航都是硬伤；
            这里补一个只给读屏与搜索引擎的 h1，视觉上完全不改动版式 */}
        <h1 class="sr-only">
          {SITE.author.fullName} — {SITE.author.jobTitle}
        </h1>
        <h2 class="text-sm font-light m-0 text-darkslate-300">欢迎</h2>

        <p class="sr-only">
          你好，我是{SITE.author.fullName}，一名刚刚毕业的应届生。我唯一的核心能力是用
          AI Agent 解决问题、完成工作——工作区里我用 AI Agent
          搭建的所有项目（游戏世界、智能体工坊、这份简历）都是证明。我现在正在寻找一份计算机相关的工作，希望把
          AI Agent 真正用起来。
        </p>
        <p aria-hidden="true" class="m-0 font-light text-base">
          <span>
            你好，我是 <b class="font-bold">{SITE.author.fullName}</b>，一名刚毕业的应届生。
          </span>
          <br />
          <span class="block mt-2">
            我唯一的核心能力是用 AI Agent 解决问题、完成工作。
          </span>
          <span class="block mt-2">
            工作区里我用 AI Agent
            搭建的所有项目（游戏世界、智能体工坊、这份简历）都是证明。
          </span>
          <span class="block mt-2">
            我正在寻找一份计算机相关的工作，希望把 AI Agent 真正用起来。
          </span>
        </p>
      </div>
      <div class="flex flex-col lg:flex-row gap-2 lg:gap-4">
        <div class="flex gap-2 lg:gap-4">
          <a
            href={SITE.links.github}
            aria-label="GitHub 主页"
            target="_blank"
          >
            <Button aria-label="GitHub 主页">
              <Icon name="ri:github-fill" />
              <span class="sr-only">GitHub 主页</span>
            </Button>
          </a>
          <a
            href="http://101.42.45.157/"
            aria-label="在线作品集"
            target="_blank"
          >
            <Button aria-label="在线作品集">
              <Icon name="ri:earth-line" />
              <span class="sr-only">在线作品集</span>
            </Button>
          </a>
          <a
            href={SITE.links.resume}
            aria-label="下载简历 PDF"
            download="于翔堃-求职简历-2026.pdf"
          >
            <Button aria-label="下载简历 PDF" class="!text-base">
              <Icon name="ri:download-line" />
              <span>下载简历</span>
            </Button>
          </a>
          <span class="btn-shell relative inline-flex w-fit h-full">
            <button
              type="button"
              id="homeEmailBtn"
              data-email={SITE.links.email}
              aria-label="复制并显示邮箱"
              class="btn--ns btn-chrome h-full w-fit text-xl max-h-[50px] px-5 py-2 cursor-pointer rounded-lg"
            >
              <Icon name="ri:mail-fill" />
              <span class="sr-only">复制并显示邮箱</span>
            </button>
            <div class="tt-shell email-bubble absolute" id="homeEmailBubble" hidden>
              <div class="tt--ns max-w-[19rem] p-2 bg-black text-white text-center rounded-lg shadow-custom shadow-primary-500 border border-primary-500">
                <span class="text-sm leading-relaxed">{SITE.links.email}</span>
              </div>
            </div>
          </span>
          <Tooltip client:visible>
            <Button aria-label="彩蛋按钮">
              <Icon name="ri:emotion-laugh-line" />
              <span class="sr-only">彩蛋按钮</span>
            </Button>
          </Tooltip>
        </div>
        <span class="sr-only" id="homeEmailLive" aria-live="polite"></span>
      </div>
    </div>
  </div>
</Card>

<style>
  /* 邮箱气泡定位复用全局 .tt-shell 权威规则（按钮正上方 8px、水平居中），
     这里只放本气泡的差异样式；显示/隐藏一律由 hidden 属性控制，禁止用 display 覆盖。 */
  .email-bubble {
    min-width: max-content;
  }
</style>

<script>
  // 站点全局启用 Astro View Transitions（ClientRouter）。
  // 旧写法在加载时一次性缓存元素引用，导航回到首页后节点已被换走，监听器随之失效。
  // 改为 document 级委托，点击时动态解析各元素，规避失效问题。
  // 剪贴板写入统一走 src/lib/clipboard.ts（clipboard API → execCommand 兜底 → 失败如实报错）。
  // 复制结果提示统一走 src/lib/copy-toast.ts（跟随点击位置的浮动 toast，一眼可见）。
  import { 写剪贴板 } from "../lib/clipboard";
  import { 显示复制提示 } from "../lib/copy-toast";

  document.addEventListener("click", (e: Event) => {
    const 目标 = e.target as HTMLElement | null;
    if (!目标) return;
    const 按钮 = 目标.closest<HTMLButtonElement>("#homeEmailBtn");
    if (!按钮) return;

    const 邮箱 = 按钮.dataset.email ?? "";
    const 气泡 = document.getElementById("homeEmailBubble") as HTMLDivElement | null;
    const 读屏提示 = document.getElementById("homeEmailLive");
    if (!气泡) return;

    void (async () => {
      const 复制成功 = await 写剪贴板(邮箱);

      // 再次点击收起（toggle），显示/隐藏一律用 hidden 属性
      气泡.hidden = !气泡.hidden;

      const 鼠标 = e as MouseEvent;
      显示复制提示(复制成功, 鼠标.clientX, 鼠标.clientY);
      if (读屏提示) 读屏提示.textContent = 复制成功 ? "邮箱已复制到剪切板" : "复制失败，请手动复制";
    })();
  });
</script>
