---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";

const socialLinkClass =
  "copyable-link inline-block w-fit text-darkslate-100 hover:text-primary-400 hover:translate-x-0.5 transition-all duration-150";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-3" class="pad-lg">
  <div class="h-full">
    <header class="flex items-center">
      <h2 class="text-white text-xl font-bold">欢迎与我共事！</h2>
    </header>

    <div class="flex flex-col mt-4">
      <p class="text-darkslate-300 m-0">{SITE.location.countryName}</p>
    </div>

    <div class="flex flex-col mt-4 w-fit">
      <h2 class="text-darkslate-300">在这些平台找到我</h2>
      <ul class="platform-list">
        <li>
          <a href={SITE.links.github} target="_blank" class={socialLinkClass}>
            GitHub
          </a>
        </li>
        <li>
          <button
            type="button"
            class={`${socialLinkClass} tracking-tighter`}
            data-copy={SITE.links.email}
          >
            邮箱：{SITE.links.email}
          </button>
        </li>
        <li>
          <button type="button" class={socialLinkClass} data-copy="3062949899">
            QQ：3062949899
          </button>
        </li>
        <li>
          <button type="button" class={socialLinkClass} data-copy="13312137630">
            手机：13312137630
          </button>
        </li>
        <li>
          <button type="button" class={socialLinkClass} data-copy="yu040307">
            微信：yu040307
          </button>
        </li>
      </ul>
      <span class="sr-only" id="contactCopyLive" aria-live="polite"></span>
    </div>
  </div>
</Card>

<style>
  .platform-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .copyable-link {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }
</style>

<script>
  // 站点全局启用了 Astro View Transitions（ClientRouter）。
  // 旧写法在模块脚本加载时一次性查询 .platform-list 并绑定，但 View Transitions 下
  // 模块脚本仅在初次加载执行一次，导航回到首页后旧 DOM 节点已被换走，绑在旧节点上的
  // 监听器随之失效。改为 document 级委托：document 在视图切换间始终存活，且每次点击都
  // 动态解析目标节点，从而对任意一次注入的节点都生效。
  // 剪贴板写入统一走 src/lib/clipboard.ts（clipboard API → execCommand 兜底 → 失败如实报错）。
  // 复制结果提示统一走 src/lib/copy-toast.ts（跟随点击位置的浮动 toast，一眼可见）。
  import { 写剪贴板 } from "../lib/clipboard";
  import { 显示复制提示 } from "../lib/copy-toast";

  document.addEventListener("click", (e: Event) => {
    const 目标 = e.target as HTMLElement | null;
    if (!目标) return;
    const 按钮 = 目标.closest<HTMLElement>(".copyable-link[data-copy]");
    if (!按钮) return;

    const 文本 = 按钮.dataset.copy ?? "";
    if (!文本) return;

    const 读屏提示 = document.getElementById("contactCopyLive");
    // 剪贴板写入统一走 src/lib/clipboard.ts（clipboard API → execCommand 兜底 → 失败如实报错）。
    void (async () => {
      const 复制成功 = await 写剪贴板(文本);
      const 鼠标 = e as MouseEvent;
      显示复制提示(复制成功, 鼠标.clientX, 鼠标.clientY);
      if (读屏提示) 读屏提示.textContent = 复制成功 ? "已复制到剪切板" : "复制失败，请手动复制";
    })();
  });
</script>
