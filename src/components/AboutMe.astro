---
import Card from "./Card/index.astro";

const stack = [
  {
    group: "AI Agent / LLM 工程",
    items: ["多步推理 Agent 运行时", "RAG（BM25 + 向量 RRF 融合）", "MCP 协议网关", "SSE 流式输出", "三级降级容错", "工具调用"],
  },
  {
    group: "编程语言",
    items: ["Python", "TypeScript", "Java", "JavaScript"],
  },
  {
    group: "前端",
    items: ["React 18", "Astro", "Vue 3", "Vite", "Canvas 2D", "WCAG 2.1 无障碍适配"],
  },
  {
    group: "后端",
    items: ["FastAPI", "Node.js", "Spring Boot 3.5", "MyBatis", "REST API", "JWT 鉴权"],
  },
  {
    group: "数据库",
    items: ["MySQL", "SQLAlchemy 异步 ORM", "Redis（入门）", "SQLite"],
  },
  {
    group: "部署与运维",
    items: ["腾讯云（Windows Server 2022）", "Docker（多阶段构建 + compose）", "Nginx", "服务守护与自愈", "Linux（WSL2，学习中）", "Git"],
  },
  {
    group: "AI 编程工具链",
    items: ["Claude Code", "Codex", "TRAE", "WorkBuddy", "可复用技能库", "MCP 服务端集成", "Git 提交前钩子（凭据 / 硬编码 / SQL 注入 / 翻译键）"],
  },
  {
    group: "测试",
    items: ["pytest", "JUnit 5 + Mockito"],
  },
];

const CHIP =
  "text-2xs px-2 py-0.5 rounded-full border border-darkslate-400 text-darkslate-100 hover:border-primary-500 hover:text-white transition-colors duration-150 cursor-default";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-6"
  title="技术栈与工具"
  class="pad-lg"
>
  <div class="flex flex-col gap-3">
    {
      stack.map(({ group, items }) => (
        <div class="flex flex-col gap-1.5">
          <span class="text-3xs uppercase tracking-wider text-darkslate-300">
            {group}
          </span>
          <div class="flex flex-wrap gap-1.5">
            {items.map((label) => (
              <span class={CHIP}>{label}</span>
            ))}
          </div>
        </div>
      ))
    }
    <p class="text-3xs text-darkslate-300 mt-3 leading-relaxed">
      以上项目均为个人独立完成的自研 / 课程项目，非企业生产环境；未使用 Dify / Coze / LangChain，相关能力以自研实现，可快速迁移至主流框架。
    </p>
  </div>
</Card>
