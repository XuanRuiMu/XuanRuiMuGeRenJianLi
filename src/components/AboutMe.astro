---
import Card from "./Card/index.astro";

const stack = [
  {
    group: "AI Agent",
    items: ["Skill 开发", "Agent 工作流", "RAG 检索", "MCP 协议"],
  },
  {
    group: "前端",
    items: ["React 18", "TypeScript", "Astro", "Vite"],
  },
  {
    group: "后端",
    items: ["Python FastAPI", "Node.js", "SSE 流式"],
  },
  {
    group: "数据库",
    items: ["MySQL", "SQLAlchemy 异步 ORM", "SQLite"],
  },
  {
    group: "工具 & 运维",
    items: ["Git", "Playwright 自动化测试", " 服务端"],
  },
];

const CHIP =
  "text-2xs px-2 py-0.5 rounded-full border border-darkslate-400 text-darkslate-100 hover:border-primary-500 hover:text-white transition-colors duration-150 cursor-default";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-6"
  title="技术栈与工具"
  class="pad-lg"
>
  <div class="flex flex-col gap-3">
    {
      stack.map(({ group, items }) => (
        <div class="flex flex-col gap-1.5">
          <span class="text-3xs uppercase tracking-wider text-darkslate-300">
            {group}
          </span>
          <div class="flex flex-wrap gap-1.5">
            {items.map((label) => (
              <span class={CHIP}>{label}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Card>
